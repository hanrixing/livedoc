{
  "meta": {
    "title": "麦麦省钱周报",
    "avatar": "@麦麦省钱官分身",
    "desc": "数据源全部来自麦当劳官方 MCP，重跑即更新；数字分身口播讲稿同步刷新。",
    "privacy": "live 模式产出含个人券信息，仅限本地查看；公开仓库请使用 --demo 模式",
    "sensitive": true
  },

  "labels": {
    "coupon_count": "卡包券数",
    "coupon_first": "最近一张券",
    "coupon_expiry": "有效期",
    "claimable_count": "本周可领券",
    "today_campaign": "今日活动",
    "expiry_days": "剩余天数",
    "expiry_date": "到期日"
  },

  "data_sources": [
    {
      "id": "my_coupons",
      "type": "mcp",
      "server": "mcd-mcp",
      "tool": "query-my-coupons",
      "args": {},
      "extract": {
        "coupon_count": "共\\s*(\\d+)\\s*张可用优惠券",
        "coupon_first": "##\\s*(.+)",
        "coupon_expiry": "有效期\\*\\*:\\s*([0-9\\-: ]+)"
      },
      "fallback": {
        "coupon_count": 3,
        "coupon_first": "示例：9.9 元饮品券",
        "coupon_expiry": "2026-10-15 00:00-2026-10-20 23:59"
      }
    },
    {
      "id": "available_coupons",
      "type": "mcp",
      "server": "mcd-mcp",
      "tool": "available-coupons",
      "args": {},
      "extract": {
        "claimable_count": { "op": "count", "pattern": "优惠券标题" }
      },
      "fallback": { "claimable_count": 6 }
    },
    {
      "id": "campaign",
      "type": "mcp",
      "server": "mcd-mcp",
      "tool": "campaign-calendar",
      "args": {},
      "extract": {
        "today_campaign": "活动标题\\*\\*：(.+)"
      },
      "fallback": { "today_campaign": "示例：超值 9.9 元早餐两件套" }
    }
  ],

  "compute": {
    "expiry_days": { "op": "days_until", "from": "coupon_expiry" },
    "expiry_date": { "op": "last_date", "from": "coupon_expiry" }
  },

  "script": [
    {
      "shot": "开场 · 本周可领",
      "speak": "你好，我是你的麦麦省钱官。本周麦麦省一共放出 {claimable_count} 张可领券，我都帮你列好了，一键就能领。",
      "camera": "中景平视，数字分身在麦当劳柜台前自然走动，轻微推近",
      "visual": "背景虚化的麦当劳门店暖光，分身右手轻点空中浮现 {claimable_count} 张券卡片"
    },
    {
      "shot": "卡包盘点",
      "speak": "再看你自己的卡包，现在有 {coupon_count} 张券可用，第一张是{coupon_first}。",
      "camera": "近景，分身低头看手机，镜头缓推到肩部以上",
      "visual": "手机屏幕浮起卡包界面，{coupon_count} 张券依次滑过，暖黄券面高光"
    },
    {
      "shot": "到期预警（核心差异）",
      "speak": "重点提醒：{coupon_first}这张券 {expiry_date} 到期，只剩 {expiry_days} 天了，别浪费。",
      "camera": "特写急推，分身抬手做出提醒手势，画面轻微震动",
      "visual": "券面上浮现红色倒计时「{expiry_days} 天」，数字跳动伴随红色警示辉光"
    },
    {
      "shot": "今日活动与行动",
      "speak": "今天门店在推的是：{today_campaign}。领券加上活动，这周能省下一顿早餐钱。",
      "camera": "中景横移跟拍，分身走向取餐台，收尾定格",
      "visual": "今日活动海报从右侧滑入，分身微笑指向海报，暖色调收尾"
    }
  ]
}
